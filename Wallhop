-- Enhanced number input with validation feedback
local function createSetting(name, default, yPos, callback, min, max)
    min, max = min or -math.huge, max or math.huge
    
    local label = Instance.new("TextLabel")
    label.Size              = UDim2.new(0.55, 0, 0, 22)
    label.Position          = UDim2.new(0, 12, 0, yPos)
    label.BackgroundTransparency = 1
    label.Text              = name
    label.TextColor3        = C.TextSub
    label.TextSize          = 12
    label.Font              = Enum.Font.Gotham
    label.TextXAlignment    = Enum.TextXAlignment.Left
    label.Parent            = sScroll

    local valueBox = Instance.new("TextBox")
    valueBox.Size             = UDim2.new(0.38, 0, 0, 22)
    valueBox.Position         = UDim2.new(0.60, 0, 0, yPos)
    valueBox.BackgroundColor3 = C.Surface
    valueBox.Text             = tostring(default)
    valueBox.TextColor3       = C.TextMain
    valueBox.TextSize         = 12
    valueBox.Font             = Enum.Font.Gotham
    valueBox.ClearTextOnFocus = false
    valueBox.Parent           = sScroll
    Instance.new("UICorner", valueBox).CornerRadius = UDim.new(0, 5)
    
    local boxStroke = Instance.new("UIStroke", valueBox)
    boxStroke.Color = C.Border
    boxStroke.Thickness = 1

    valueBox.FocusLost:Connect(function()
        local num = tonumber(valueBox.Text)
        if num then
            num = math.clamp(num, min, max)
            valueBox.Text = tostring(num)
            callback(num)
            TweenService:Create(boxStroke, TweenInfo.new(0.15), {Color = C.Green}):Play()
            task.delay(0.8, function()
                TweenService:Create(boxStroke, TweenInfo.new(0.3), {Color = C.Border}):Play()
            end)
        else
            valueBox.Text = tostring(default)
            TweenService:Create(boxStroke, TweenInfo.new(0.15), {Color = C.Red}):Play()
            task.delay(0.8, function()
                TweenService:Create(boxStroke, TweenInfo.new(0.3), {Color = C.Border}):Play()
            end)
        end
    end)
    
    return valueBox
end

-- Enhanced toggle with icon
local function makeToggleRow(labelText, initState, yPos, onChanged)
    local lbl = Instance.new("TextLabel")
    lbl.Size              = UDim2.new(0.55, 0, 0, 24)
    lbl.Position          = UDim2.new(0, 12, 0, yPos)
    lbl.BackgroundTransparency = 1
    lbl.Text              = labelText
    lbl.TextColor3        = C.TextSub
    lbl.TextSize          = 12
    lbl.Font              = Enum.Font.Gotham
    lbl.TextXAlignment    = Enum.TextXAlignment.Left
    lbl.Parent            = sScroll

    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(0.38, 0, 0, 24)
    btn.Position         = UDim2.new(0.60, 0, 0, yPos)
    btn.BackgroundColor3 = initState and Color3.fromRGB(20,45,30) or C.Surface
    btn.Text             = initState and "ON ✓" or "OFF"
    btn.TextColor3       = initState and C.Green or C.Red
    btn.TextSize         = 12
    btn.Font             = Enum.Font.GothamBold
    btn.Parent           = sScroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    
    local st = Instance.new("UIStroke", btn)
    st.Color = initState and C.Green or C.Border
    st.Thickness = 1.2

    local state = initState
    btn.MouseButton1Click:Connect(function()
        state = not state
        TweenService:Create(btn, TweenInfo.new(0.12), {
            BackgroundColor3 = state and Color3.fromRGB(20,45,30) or C.Surface
        }):Play()
        TweenService:Create(st, TweenInfo.new(0.12), {
            Color = state and C.Green or C.Border
        }):Play()
        btn.Text       = state and "ON ✓" or "OFF"
        btn.TextColor3 = state and C.Green or C.Red
        onChanged(state)
    end)
    return btn, st
end

-- Enhanced keybind with better UX
local function makeKeybindRow(labelText, getCurrentKey, yPos, setKey)
    local lbl = Instance.new("TextLabel")
    lbl.Size              = UDim2.new(0.50, 0, 0, 24)
    lbl.Position          = UDim2.new(0, 12, 0, yPos)
    lbl.BackgroundTransparency = 1
    lbl.Text              = labelText
    lbl.TextColor3        = C.TextSub
    lbl.TextSize          = 12
    lbl.Font              = Enum.Font.Gotham
    lbl.TextXAlignment    = Enum.TextXAlignment.Left
    lbl.Parent            = sScroll

    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(0.42, 0, 0, 24)
    btn.Position         = UDim2.new(0.56, 0, 0, yPos)
    btn.BackgroundColor3 = C.Surface
    btn.Text             = getCurrentKey().Name
    btn.TextColor3       = C.TextMain
    btn.TextSize         = 11
    btn.Font             = Enum.Font.GothamBold
    btn.Parent           = sScroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    
    local bst = Instance.new("UIStroke", btn)
    bst.Color = C.Border
    bst.Thickness = 1

    btn.MouseButton1Click:Connect(function()
        if rebindTarget then return end
        rebindTarget   = btn
        rebindCallback = function(kc)
            setKey(kc)
            btn.Text       = kc.Name
            btn.TextColor3 = C.TextMain
            TweenService:Create(bst, TweenInfo.new(0.12), {Color = C.Green}):Play()
            task.delay(0.6, function()
                TweenService:Create(bst, TweenInfo.new(0.3), {Color = C.Border}):Play()
            end)
        end
        btn.Text       = "Press key..."
        btn.TextColor3 = C.Yellow
        TweenService:Create(bst, TweenInfo.new(0.12), {Color = C.Yellow}):Play()
    end)
end


local function setEnabled(val)
    enabled = val
    local color = val and C.Green or C.Red
    TweenService:Create(statusLbl, TweenInfo.new(0.15), {TextColor3 = color}):Play()
    TweenService:Create(statusDot, TweenInfo.new(0.15), {BackgroundColor3 = color}):Play()
    TweenService:Create(accentBar, TweenInfo.new(0.2), {BackgroundColor3 = val and modeColors[currentMode] or C.Accent}):Play()
    TweenService:Create(outerStroke, TweenInfo.new(0.2), {Color = val and modeColors[currentMode] or C.Border}):Play()
    statusLbl.Text = val and "ON" or "OFF"
    
    -- Scale animation on toggle
    TweenService:Create(frame, TweenInfo.new(0.15), {
        Size = UDim2.new(0, val and 206 or 200, 0, val and 84 or 80)
    }):Play()
    task.delay(0.15, function()
        TweenService:Create(frame, TweenInfo.new(0.15), {
            Size = UDim2.new(0, 200, 0, 80)
        }):Play()
    end)
end

local function toggleEnabled()
    setEnabled(not enabled)
end

local function switchMode(m)
    currentMode = m
    updateTabs()
    local col = modeColors[m]
    TweenService:Create(accentBar, TweenInfo.new(0.2), {BackgroundColor3 = enabled and col or C.Accent}):Play()
    TweenService:Create(outerStroke, TweenInfo.new(0.2), {Color = enabled and col or C.Border}):Play()
end

-- =============================================
-- KEYBIND HANDLER (Fixed rebind race condition)
-- =============================================
trackConnection(UserInputService.InputBegan:Connect(function(input, gp)
    if rebindTarget then
        if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode ~= Enum.KeyCode.Escape then
            rebindCallback(input.KeyCode)
            rebindTarget   = nil
            rebindCallback = nil
        elseif input.KeyCode == Enum.KeyCode.Escape then
            -- Cancel rebind
            rebindTarget.Text = rebindTarget.Text:match("ON") and "ON" or rebindTarget.Text:match("OFF") and "OFF" or "..."
            rebindTarget.TextColor3 = C.TextMain
            TweenService:Create(rebindTarget:FindFirstChildOfClass("UIStroke"), TweenInfo.new(0.12), {Color = C.Border}):Play()
            rebindTarget   = nil
            rebindCallback = nil
        end
        return
    end

    if input.KeyCode == KEY_TOGGLE then
        toggleEnabled()
        return
    end
    if input.KeyCode == KEY_INF_MODE then
        switchMode(1)
        return
    end
    if input.KeyCode == KEY_CAM_MODE then
        switchMode(2)
        return
    end
end))

-- =============================================
-- DRAG SYSTEM (Fixed for all surfaces)
-- =============================================
local DRAG_THRESHOLD = 6
local isDragging, dragStartPos, frameStartPos = false, nil, nil

local dragSurfaces = {frame, header, toggleBtn, gearBtn, tabRow, tab1, tab2, tabSlider, pillBG, statusLbl, keyHint}

for _, surface in ipairs(dragSurfaces) do
    trackConnection(surface.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            isDragging    = false
            dragStartPos  = input.Position
            frameStartPos = frame.Position
        end
    end))
end

trackConnection(UserInputService.InputChanged:Connect(function(input)
    if not dragStartPos then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then return end

    local delta = input.Position - dragStartPos
    if not isDragging and (math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD) then
        isDragging = true
    end

    if isDragging then
        frame.Position = UDim2.new(
            frameStartPos.X.Scale, frameStartPos.X.Offset + delta.X,
            frameStartPos.Y.Scale, frameStartPos.Y.Offset + delta.Y
        )
    end
end))

trackConnection(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragStartPos = nil
        isDragging   = false
    end
end))

